            "mimeType": "application/json",
            "text": "{\"responseDescription\":\"SUCCESS\",\"responseTitle\":\"\",\"language\":\"EN\",\"data\":{\"title\":\"HOME PARTNER\",\"product\":{\"id\":\"131\",\"categoryId\":\"3\",\"productCode\":\"HOME PART\",\"title\":\"HOME PARTNER\",\"subtitle\":\"Thorough protection for your home and its properties from all risks\",\"icon\":\"https://on-c2-cmshub-public.s3.ap-southeast-3.amazonaws.com/TMI_Logo_White_Bg_37cfbd79f5.png\"},\"category\":\"Home Insurance\",\"description\":\"ASURANSI TOKIO MARINE INDONESIA\",\"urlDocuments\":[{\"title\":\"Brochure\",\"url\":\"https://www.ocbc.id/asset/media/Feature/individu/riplay/wm-asuransi/b-homepartner.pdf\"},{\"title\":\"FAQ\",\"url\":\"https://cdn1.ocbc.id/asset/media/Feature/Individu/RIPLAY/wm-asuransi/faq-homepartner.pdf\"},{\"title\":\"Product & Service Summary (General)\",\"url\":\"https://web.ocbc.id/riplayhp\"}],\"groups\":[{\"title\":\"Description\",\"subtitle\":\"\",\"footer\":\"\",\"sections\":[{\"contents\":[{\"value\":\"\",\"description\":\"Home Partner protects your home and its content from losses and damages\"}]}]},{\"title\":\"Benefit Options\",\"subtitle\":\"\",\"footer\":\"\",\"sections\":[{\"contents\":[{\"value\":\"\",\"description\":\"Protection against the risk of fire, lightning, explosions, aircraft crashes, smoke (FLEXAS)\"}]},{\"contents\":[{\"value\":\"\",\"description\":\"Additional coverage for housemaid’s personal belongings, rental fee, and removal of debris\"}]},{\"contents\":[{\"value\":\"\",\"description\":\"Protection against the risk of flood, windstorm, tempest, water damage (FWTWD)\"}]},{\"contents\":[{\"value\":\"\",\"description\":\"Protection against the risk of strike, riot, malicious act, damage, civil commotion (SRMDCC)\"}]},{\"contents\":[{\"value\":\"\",\"description\":\"Protection against the risk of death due to accident\"}]},{\"contents\":[{\"value\":\"\",\"description\":\"Protection against the risk of thirdparty legal liability\"}]}]},{\"title\":\"Sum Insured\",\"subtitle\":\"\",\"footer\":\"\",\"sections\":[{\"contents\":[{\"value\":\"\",\"description\":\"Min. IDR 75,000,000 for building and Max IDR 9,100,000,000 for building and it’s content\"}]}]},{\"title\":\"Transaction Info\",\"subtitle\":\"\",\"footer\":\"\",\"sections\":[{\"contents\":[{\"value\":\"Minimum Premium\",\"description\":\"IDR 100,000.00\"}]},{\"contents\":[{\"value\":\"Coverage Period\",\"description\":\"1 year\"}]}]}],\"amountSpecification\":{\"minimum\":0.0000,\"maximum\":0.0000,\"multiplier\":0.0000},\"travelerCapacity\":{\"adult\":{\"minimum\":0,\"maximum\":0,\"multiplier\":0},\"children\":{\"minimum\":0,\"maximum\":0,\"multiplier\":0},\"note\":\"\"},\"questions\":[{\"code\":\"HP001\",\"type\":\"\",\"question\":\"Are the main frames (walls, columns, roofs and floors) of your house made of flammable material?\",\"answers\":[{\"code\":\"Y\",\"value\":\"Yes\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]},{\"code\":\"N\",\"value\":\"No\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]}],\"tips\":\"\"},{\"code\":\"HP002\",\"type\":\"\",\"question\":\"Is the road in front of your house only accessible by two-wheeled vehicles?\",\"answers\":[{\"code\":\"Y\",\"value\":\"Yes\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]},{\"code\":\"N\",\"value\":\"No\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]}],\"tips\":\"\"},{\"code\":\"HP003\",\"type\":\"\",\"question\":\"Has your house ever experienced a fire? \",\"answers\":[{\"code\":\"Y\",\"value\":\"Yes\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]},{\"code\":\"N\",\"value\":\"No\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]}],\"tips\":\"\"},{\"code\":\"HP004\",\"type\":\"\",\"question\":\"Is the building you insured is not a residential house? (eg: shophouses, showrooms, warehouses, boarding houses, apartments, and others).\",\"answers\":[{\"code\":\"Y\",\"value\":\"Yes\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]},{\"code\":\"N\",\"value\":\"No\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]}],\"tips\":\"\"},{\"code\":\"HP005\",\"type\":\"\",\"question\":\"Has the building you insured been flooded? \",\"answers\":[{\"code\":\"Y\",\"value\":\"Yes\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]},{\"code\":\"N\",\"value\":\"No\",\"description\":\"\",\"eventName\":\"\",\"subDescriptions\":[]}],\"tips\":\"\"}],\"url\":\"\"},\"response_code\":\"00000\"}"
